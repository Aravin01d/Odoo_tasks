<odoo>
<record id="property_model_action" model="ir.actions.act_window">
    <field name="name">Properties</field>
    <field name="res_model">property.model</field>
    <field name="view_mode">list,form</field>
</record>
    <record id="property_model_listview" model="ir.ui.view">
        <field name="name">properties.list</field>
        <field name="model">property.model</field>
        <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="property_type"/>
            <field name="postcode"/>
            <field name="bedrooms"/>
            <field name="living_area"/>
            <field name="expected_price"/>
<!--            <field name="best_price"/>-->
            <field name="selling_price"/>
            <field name="date_availability"/>
        </list>
        </field>
    </record>

    <record id="propoffer_model_listview" model="ir.ui.view">
        <field name="name">Offers.list</field>
        <field name="model">propoffer.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="price"/>
                <field name="status"/>
                <field name="partner"/>
                <field name="create_date"/>
                <field name="validity"/>
                <field name="date_deadline"/>
<!--                <field name="property"/>-->
            </list>
        </field>
    </record>

    <record id="propoffer_model_formview" model="ir.ui.view">
        <field name="name">Offers.form</field>
        <field name="model">propoffer.model</field>
        <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="price"/>
                        <field name="status"/>
                        <field name="partner"/>
                        <field name="create_date"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>
                </form>
        </field>
    </record>


<record id="property_model_formview" model="ir.ui.view">
    <field name="name">properties.form</field>
    <field name="model">property.model</field>
    <field name="arch" type="xml">
        <form string="Property Details">
            <header>
<!--                <button name="action_sold" string="sold"-->
<!--                           class="oe_highlight" type="object" />-->
<!--                <button name="action_cancel" string="Cancel"-->
<!--                           class="oe_highlight" type="object" />-->
            </header>
            <h1><field name="name" nolabel="1" placeholder="Name"/></h1>
            <field name="tags" widget="many2many_tags" placeholder="Tags"/>
            <group>
                <group>
                    <field name="property_type"/>
                    <field name="postcode"/>
                    <field name="date_availability"/>
                </group>
                <group>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
<!--                    <field name="best_price"/>-->
                </group>
            </group>
               <notebook>
                   <page string="Description">
                       <group>
                           <field name="description"/>
                           <field name="bedrooms"/>
                           <field name="living_area"/>
                           <field name="facades"/>
                           <field name="garage"/>
                           <field name="garden"/>
                           <field name="garden_area"/>
                           <field name="garden_orientation"/>
<!--                           <field name="total_area"/>-->
                           <field name="state"/>
                           <field name="active"/>
                       </group>
                   </page>
                   <page string="offers">
                               <list>
                                   <field name="offers"/>
                               </list>
                   </page>
                   <page string="other info">
                       <group>
                           <field name="buyer"/>
                           <field name="seller"/>
                       </group>
                   </page>
               </notebook>
        </form>
    </field>
</record>

    <record id="property_model_search" model="ir.ui.view">
   <field name="name">properties.search</field>
   <field name="model">property.model</field>
   <field name="arch" type="xml">
       <search>
           <field name="name" string="Name"/>
           <field name="tags" string="Tags"/>
           <field name="property_type" string="Property Types"/>
           <field name="postcode" string="Postcode"/>
           <field name="expected_price" string="Expected Price"/>
           <field name="bedrooms" string="Bedrooms"/>
           <field name="living_area" string="Living Area(sqm)"/>
           <field name="facades" string="Facades"/>
           <field name="buyer" string="Customer"/>
           <field name="seller" string="SalesPerson"/>
          <filter name="available" string="Available"
                   domain="['|',
                   ('state','=', 'received'),
                   ('state','=','new')]"/>
             <group name="groupby">
               <filter name="postcode" string="Postcode"
                       context="{'group_by': 'postcode'}"/>
           </group>
       </search>
   </field>
</record>
</odoo>


