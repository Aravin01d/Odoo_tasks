<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <data>
        <record id="res_partner_form_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                    <xpath expr="//field[@name='parent_id']" position="after">
                        <field name="most_sold_product_id"/>
                        <field name="total_sold_quantity"/>
                         <field name="minimum_sale_price"/>
                        <field name="maximum_sale_price"/>

                    </xpath>
                    <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object"
                            icon="fa-book" name="action_view_top_sales">
                        <field string="Sales of MSP" name="cos" widget="statinfo"/>
                    </button>
                    </xpath>
            </field>
        </record>
     </data>
</odoo>